ADMIN_LOGIN=losowy_login
ADMIN_PASSWORD=losowe_haslo
# Wygeneruj długi losowy ciąg (minimum 32 znaki) i nie zmieniaj go bez potrzeby.
SESSION_SECRET=ustaw_losowy_sekret_minimum_32_znaki

# Produkcja / Coolify:
# ustaw DATA_DIR=/app/data i zamontuj trwały wolumen pod /app/data.
# W tym katalogu zapisywane są usługi, realizacje, treści CMS oraz uploady.
DATA_DIR=data
