# Produkcja / Coolify:
# ustaw DATA_DIR=/app/data i zamontuj trwały wolumen pod /app/data.
# W tym katalogu zapisywane są usługi, realizacje, treści CMS oraz uploady.
DATA_DIR=data

# Live opinie Google Maps / Places API (New)
# Klucz ustaw tylko po stronie serwera w Coolify. Nie dodawaj go do VITE_* ani do kodu frontendu.
